# Copy this file to .env before starting Docker Compose.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional local Ollama connection exposed by the host machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
LLM_PROVIDER=openai
ARTICLE_MAX_AGE_DAYS=365

# Shared service credentials. Replace these outside a throwaway local demo.
AI_INGEST_API_KEY=local-ai-ingest-key-change-before-sharing-0001
AGENT_CONTROL_API_KEY=local-agent-control-key-change-before-share
JWT_ACCESS_SECRET=local-access-secret-change-before-sharing-0001
JWT_REFRESH_SECRET=local-refresh-secret-change-before-sharing-001

# Bootstrap account for the local administrative panel.
SUPERADMIN_EMAIL=admin@example.test
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeThisLocalPassword123!
SUPERADMIN_DISPLAY_NAME=Local Superadmin

GOOGLE_CLIENT_ID=
