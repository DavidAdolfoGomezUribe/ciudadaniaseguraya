{
  "name": "ciudadaniasegurayabe",
  "version": "1.0.0",
  "description": "Backend modular para la plataforma de seguridad ciudadana Ciudadania Segura Ya",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0 <25",
    "pnpm": "11.1.3"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "nodemon src/app/server.js",
    "start": "node src/app/server.js",
    "db:init": "node scripts/init-database.js",
    "db:backfill:geospatial": "node scripts/backfill-geospatial.js",
    "db:seed:superadmin": "node scripts/seed-superadmin.js",
    "db:seed:demo-incidents:2026": "node scripts/seed-demo-incidents-2026.js",
    "db:seed:demo-neighbor-incidents:2026": "node scripts/seed-demo-neighbor-incidents-2026.js",
    "postman:generate": "node scripts/generate-postman.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "keywords": [
    "fastify",
    "mongodb",
    "h3",
    "seguridad-ciudadana"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/compress": "9.1.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/sse": "0.5.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "@fastify/under-pressure": "9.1.0",
    "argon2": "0.45.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "google-auth-library": "10.9.0",
    "h3-js": "4.5.0",
    "mongodb": "7.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "eslint": "10.7.0",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "vitest": "4.1.10"
  }
}
